{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerground.example/schemas/careerground-verified-result.schema.json",
  "title": "CareerGround v5 verified result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "runId",
    "runGroupKey",
    "targetAsOfDate",
    "status",
    "counts",
    "newJobs",
    "updates",
    "ended",
    "excluded",
    "verifiedAt",
    "manifestChecksum"
  ],
  "properties": {
    "schemaVersion": { "const": "5.0" },
    "workflowId": { "const": "CG-JOBS-PROD-V5" },
    "runId": { "type": "string", "minLength": 1 },
    "runGroupKey": { "type": "string", "minLength": 1 },
    "targetAsOfDate": { "type": "string", "format": "date" },
    "status": { "const": "VERIFIED" },
    "counts": { "type": "object" },
    "newJobs": { "type": "array", "items": { "type": "object" } },
    "updates": { "type": "array", "items": { "type": "object" } },
    "ended": { "type": "array", "items": { "type": "object" } },
    "excluded": { "type": "array", "items": { "type": "object" } },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "manifestChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
