{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerground.example/schemas/careerground-run-manifest.schema.json",
  "title": "CareerGround v5 run manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "workflowId",
    "runId",
    "runGroupKey",
    "targetAsOfDate",
    "attempt",
    "mode",
    "startedAt",
    "completedAt",
    "status",
    "previousSuccessfulRunId",
    "errorCode",
    "errorMessage",
    "baseline",
    "partitions",
    "merge",
    "deduplication",
    "validation",
    "counts",
    "qualityGate",
    "db",
    "notification",
    "createdAt",
    "validatedAt",
    "publishedAt",
    "manifestChecksum"
  ],
  "properties": {
    "schemaVersion": { "const": "5.0" },
    "workflowId": { "const": "CG-JOBS-PROD-V5" },
    "runId": { "type": "string", "minLength": 1 },
    "runGroupKey": { "type": "string", "pattern": "^CG-\\d{4}-\\d{2}-\\d{2}$" },
    "targetAsOfDate": { "type": "string", "format": "date" },
    "attempt": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["DRY_RUN", "RESUME", "PUBLISH"] },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCESS_WITH_CHANGES",
        "SUCCESS_NO_CHANGES",
        "SKIPPED_WEEKEND",
        "SKIPPED_HOLIDAY",
        "FAILED_PREFLIGHT",
        "FAILED_INPUT",
        "FAILED_COLLECTION",
        "FAILED_PARTITION",
        "FAILED_MERGE",
        "FAILED_VALIDATION",
        "QUARANTINED",
        "VERIFIED",
        "FAILED_DB_SYNC",
        "PUBLISHED",
        "FAILED_NOTIFICATION"
      ]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "previousSuccessfulRunId": { "type": ["string", "null"] },
    "errorCode": { "type": ["string", "null"] },
    "errorMessage": { "type": ["string", "null"] },
    "baseline": { "type": "object" },
    "partitions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object" } },
    "merge": { "type": "object" },
    "deduplication": { "type": "object" },
    "validation": { "type": "object" },
    "counts": { "type": "object" },
    "qualityGate": { "type": "object" },
    "quarantineReasons": { "type": "array", "items": { "type": "string" } },
    "db": { "type": "object" },
    "notification": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "validatedAt": { "type": ["string", "null"], "format": "date-time" },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "manifestChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
