generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum Visibility {
  PRIVATE
  MEMBERS
}

enum CollectionItemType {
  LEARNING_SOURCE
  LEARNING_UNIT
  JOB_POSTING
  CODING_PROBLEM
  SOLUTION
  NOTE
  EXTERNAL_LINK
}

enum LearningSourceStatus {
  UPLOADED
  PROCESSING
  READY
  REQUIRES_MANUAL_PROCESSING
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
}

enum CareerScope {
  NEW_GRAD_ONLY
  NEW_GRAD_ELIGIBLE
  CAREER_ONLY
}

enum CompanySize {
  LARGE
  PUBLIC
  MID
  SMALL
  STARTUP
  FOREIGN
  UNCLASSIFIED
}

enum JobPostingStatus {
  ACTIVE
  DEADLINE_UNKNOWN
  EXPIRED
  REMOVED
  NEEDS_REVIEW
}

enum ApplicationStatus {
  INTERESTED
  PLANNED
  APPLIED
  SCREENING
  INTERVIEW
  REJECTED
  ACCEPTED
  ON_HOLD
}

enum ProblemStatus {
  UNTRIED
  IN_PROGRESS
  SOLVED
  RETRY
}

enum ReactionType {
  HELPFUL
}

enum CommentReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum NotificationType {
  COMMENT
  REPLY
  JOB_DEADLINE
  DAILY_CHALLENGE
  REVIEW_DUE
  IMPORT_ERROR
  SYSTEM
}

model User {
  id                    String                        @id @default(uuid()) @db.Uuid
  email                 String                        @unique @db.VarChar(320)
  openAiUserId          String?                       @unique @db.VarChar(255)
  displayName           String                        @db.VarChar(80)
  role                  Role                          @default(MEMBER)
  isActive              Boolean                       @default(true)
  avatarUrl             String?                       @db.VarChar(500)
  githubUsername        String?                       @db.VarChar(100)
  preferredLanguage     String                        @default("javascript") @db.VarChar(40)
  onboardingCompletedAt DateTime?
  rankingOptIn          Boolean                       @default(true)
  dataDeletionRequested DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  deletedAt             DateTime?
  preference            UserPreference?
  collections           Collection[]
  notes                 Note[]
  learningProgress      LearningProgress[]
  reviewSchedules       ReviewSchedule[]
  savedJobs             SavedJob[]
  problemProgress       ProblemProgress[]
  dailyParticipations   DailyChallengeParticipation[]
  solutions             Solution[]
  solutionReactions     SolutionReaction[]
  solutionComments      SolutionComment[]
  commentReports        CommentReport[]
  notifications         Notification[]
  auditLogs             AuditLog[]                    @relation("AuditActor")
  hiddenComments        SolutionComment[]             @relation("CommentModerator")
  publishedLearning     LearningSource[]              @relation("LearningPublisher")
}

model UserPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  homeViewMode          String   @default("GRID") @db.VarChar(20)
  homeSort              String   @default("UPDATED_DESC") @db.VarChar(40)
  emailNotifications    Boolean  @default(false)
  commentNotifications  Boolean  @default(true)
  deadlineNotifications Boolean  @default(true)
  reviewNotifications   Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Collection {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  parentId  String?          @db.Uuid
  name      String           @db.VarChar(80)
  icon      String           @default("folder") @db.VarChar(40)
  color     String           @default("amber") @db.VarChar(30)
  position  Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Collection?      @relation("CollectionTree", fields: [parentId], references: [id])
  children  Collection[]     @relation("CollectionTree")
  items     CollectionItem[]

  @@index([userId, parentId, position])
  @@index([userId, deletedAt])
}

model CollectionItem {
  id           String             @id @default(uuid()) @db.Uuid
  collectionId String             @db.Uuid
  itemType     CollectionItemType
  targetId     String             @db.VarChar(500)
  label        String?            @db.VarChar(240)
  position     Int                @default(0)
  createdAt    DateTime           @default(now())
  collection   Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, itemType, targetId])
  @@index([collectionId, position])
}

model Note {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  title      String         @db.VarChar(200)
  markdown   String
  visibility Visibility     @default(PRIVATE)
  linkedType String?        @db.VarChar(40)
  linkedId   String?        @db.VarChar(100)
  currentRev Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions  NoteRevision[]

  @@index([userId, updatedAt])
  @@index([linkedType, linkedId])
}

model NoteRevision {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @db.Uuid
  revision  Int
  markdown  String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, revision])
}

model LearningSource {
  id            String                  @id @default(uuid()) @db.Uuid
  title         String                  @db.VarChar(200)
  subject       String                  @db.VarChar(100)
  category      String                  @db.VarChar(100)
  visibility    Visibility              @default(MEMBERS)
  status        LearningSourceStatus    @default(UPLOADED)
  publishedById String?                 @db.Uuid
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?
  publishedBy   User?                   @relation("LearningPublisher", fields: [publishedById], references: [id])
  versions      LearningSourceVersion[]
  units         LearningUnit[]
}

model LearningSourceVersion {
  id             String          @id @default(uuid()) @db.Uuid
  sourceId       String          @db.Uuid
  version        String          @db.VarChar(40)
  fileName       String?         @db.VarChar(255)
  mimeType       String?         @db.VarChar(120)
  storageKey     String?         @db.VarChar(500)
  sha256         String          @unique @db.Char(64)
  extractionMeta Json?
  createdAt      DateTime        @default(now())
  source         LearningSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  jobs           ProcessingJob[]

  @@unique([sourceId, version])
}

model LearningUnit {
  id         String                    @id @default(uuid()) @db.Uuid
  sourceId   String                    @db.Uuid
  anchor     String                    @db.VarChar(200)
  title      String                    @db.VarChar(200)
  summary    String
  concepts   String[]
  position   Int                       @default(0)
  published  Boolean                   @default(false)
  currentRev Int                       @default(1)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  source     LearningSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  revisions  LearningContentRevision[]
  flashcards Flashcard[]
  questions  LearningQuestion[]
  progress   LearningProgress[]
  schedules  ReviewSchedule[]

  @@unique([sourceId, anchor])
  @@index([sourceId, position])
}

model LearningContentRevision {
  id        String       @id @default(uuid()) @db.Uuid
  unitId    String       @db.Uuid
  revision  Int
  markdown  String
  createdAt DateTime     @default(now())
  unit      LearningUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, revision])
}

model Flashcard {
  id        String       @id @default(uuid()) @db.Uuid
  unitId    String       @db.Uuid
  front     String
  back      String
  createdAt DateTime     @default(now())
  unit      LearningUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model LearningQuestion {
  id        String       @id @default(uuid()) @db.Uuid
  unitId    String       @db.Uuid
  type      String       @db.VarChar(30)
  prompt    String
  answer    String
  choices   String[]
  createdAt DateTime     @default(now())
  unit      LearningUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model LearningProgress {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  unitId          String       @db.Uuid
  completed       Boolean      @default(false)
  understanding   Int?
  lastStudiedAt   DateTime?
  nextReviewAt    DateTime?
  repetitionCount Int          @default(0)
  intervalDays    Int          @default(1)
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit            LearningUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId, nextReviewAt])
}

model ReviewSchedule {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  unitId      String       @db.Uuid
  dueAt       DateTime
  completedAt DateTime?
  rating      Int?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        LearningUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt, completedAt])
}

model ProcessingJob {
  id              String                 @id @default(uuid()) @db.Uuid
  sourceVersionId String?                @db.Uuid
  kind            String                 @db.VarChar(50)
  idempotencyKey  String                 @unique @db.VarChar(160)
  status          ProcessingStatus       @default(PENDING)
  attempt         Int                    @default(0)
  input           Json
  output          Json?
  errorCode       String?                @db.VarChar(80)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sourceVersion   LearningSourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model JobSource {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique @db.VarChar(80)
  homeUrl       String?      @db.VarChar(500)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastError     String?
  postings      JobPosting[]
}

model JobImportBatch {
  id               String   @id @default(uuid()) @db.Uuid
  checksum         String   @unique @db.Char(64)
  importVersion    String   @db.VarChar(20)
  sourceCount      Int
  originalCount    Int
  createdCount     Int
  updatedCount     Int
  duplicateCount   Int
  rejectedCount    Int
  expiredCount     Int
  needsReviewCount Int
  report           Json
  approvedById     String?  @db.Uuid
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

model Company {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @unique @db.VarChar(160)
  normalizedName String         @unique @db.VarChar(160)
  size           CompanySize    @default(UNCLASSIFIED)
  sizeEvidence   String?
  evidenceUrl    String?        @db.VarChar(500)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  aliases        CompanyAlias[]
  postings       JobPosting[]
}

model CompanyAlias {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @db.Uuid
  alias           String  @unique @db.VarChar(160)
  normalizedAlias String  @unique @db.VarChar(160)
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id                  String           @id @default(uuid()) @db.Uuid
  sourceId            String           @db.Uuid
  companyId           String           @db.Uuid
  sourcePostingId     String?          @db.VarChar(200)
  sourceUrl           String           @db.VarChar(1000)
  canonicalUrl        String           @unique @db.VarChar(1000)
  title               String           @db.VarChar(240)
  category            String           @db.VarChar(80)
  subcategory         String?          @db.VarChar(80)
  careerScope         CareerScope
  careerEvidence      String
  companySizeEvidence String?
  employmentType      String           @db.VarChar(80)
  region              String           @db.VarChar(160)
  remote              Boolean          @default(false)
  techStack           String[]
  publishedAt         DateTime?
  deadlineAt          DateTime?
  rolling             Boolean          @default(false)
  collectedAt         DateTime
  lastVerifiedAt      DateTime
  fingerprint         String           @db.Char(64)
  summary             String
  status              JobPostingStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  source              JobSource        @relation(fields: [sourceId], references: [id])
  company             Company          @relation(fields: [companyId], references: [id])
  savedBy             SavedJob[]

  @@unique([sourceId, sourcePostingId])
  @@index([status, deadlineAt])
  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([status, category, createdAt])
  @@index([companyId, title])
}

model SavedJob {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  jobId     String            @db.Uuid
  status    ApplicationStatus @default(INTERESTED)
  memo      String            @default("")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status])
}

model CodingProblem {
  id           String            @id @default(uuid()) @db.Uuid
  source       String            @default("PROGRAMMERS") @db.VarChar(30)
  sourceUrl    String            @unique @db.VarChar(1000)
  displayTitle String            @db.VarChar(160)
  level        Int
  tags         String[]
  order        Int               @default(0)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  progress     ProblemProgress[]
  solutions    Solution[]
  challenges   DailyChallenge[]
}

model ProblemProgress {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  problemId String        @db.Uuid
  status    ProblemStatus @default(UNTRIED)
  favorite  Boolean       @default(false)
  memo      String        @default("")
  solvedAt  DateTime?
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
}

model DailyChallengeSetting {
  id                    Int      @id @default(1)
  allowedLevels         Int[]
  repeatExclusionDays   Int      @default(60)
  allowRepeatRelaxation Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model DailyChallenge {
  id               String                        @id @default(uuid()) @db.Uuid
  kstDate          DateTime                      @unique @db.Date
  problemId        String                        @db.Uuid
  candidateCount   Int
  allowedLevels    Int[]
  repeatWindowDays Int
  selectionSeed    String                        @db.VarChar(100)
  selectionReason  String                        @db.VarChar(500)
  createdAt        DateTime                      @default(now())
  problem          CodingProblem                 @relation(fields: [problemId], references: [id])
  participations   DailyChallengeParticipation[]

  @@index([createdAt])
}

model DailyChallengeParticipation {
  id          String         @id @default(uuid()) @db.Uuid
  challengeId String         @db.Uuid
  userId      String         @db.Uuid
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId, completedAt])
}

model Solution {
  id              String             @id @default(uuid()) @db.Uuid
  problemId       String             @db.Uuid
  authorId        String             @db.Uuid
  title           String             @db.VarChar(200)
  language        String             @db.VarChar(40)
  code            String
  description     String
  timeComplexity  String?            @db.VarChar(100)
  spaceComplexity String?            @db.VarChar(100)
  lessons         String             @default("")
  solved          Boolean            @default(false)
  solvedAt        DateTime?
  visibility      Visibility         @default(MEMBERS)
  currentRev      Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  problem         CodingProblem      @relation(fields: [problemId], references: [id])
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  revisions       SolutionRevision[]
  reactions       SolutionReaction[]
  comments        SolutionComment[]

  @@index([problemId, visibility, updatedAt])
  @@index([authorId, solvedAt])
}

model SolutionRevision {
  id          String   @id @default(uuid()) @db.Uuid
  solutionId  String   @db.Uuid
  revision    Int
  code        String
  description String
  createdAt   DateTime @default(now())
  solution    Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([solutionId, revision])
}

model SolutionReaction {
  id         String       @id @default(uuid()) @db.Uuid
  solutionId String       @db.Uuid
  userId     String       @db.Uuid
  type       ReactionType @default(HELPFUL)
  createdAt  DateTime     @default(now())
  solution   Solution     @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([solutionId, userId, type])
}

model SolutionComment {
  id         String            @id @default(uuid()) @db.Uuid
  solutionId String            @db.Uuid
  authorId   String            @db.Uuid
  parentId   String?           @db.Uuid
  markdown   String
  editedAt   DateTime?
  deletedAt  DateTime?
  hiddenAt   DateTime?
  hiddenById String?           @db.Uuid
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  solution   Solution          @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     SolutionComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    SolutionComment[] @relation("CommentReplies")
  hiddenBy   User?             @relation("CommentModerator", fields: [hiddenById], references: [id])
  reports    CommentReport[]

  @@index([solutionId, createdAt])
  @@index([parentId])
}

model CommentReport {
  id         String              @id @default(uuid()) @db.Uuid
  commentId  String              @db.Uuid
  reporterId String              @db.Uuid
  reason     String              @db.VarChar(500)
  status     CommentReportStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  comment    SolutionComment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.VarChar(500)
  href      String?          @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  expiresAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  targetType String   @db.VarChar(80)
  targetId   String?  @db.VarChar(100)
  requestId  String?  @db.VarChar(100)
  ipHash     String?  @db.VarChar(128)
  metadata   Json
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}
