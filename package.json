{
  "name": "careerground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.14.1 <27",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "node --import tsx deployment/sites/dev.ts",
    "dev:sites:api": "node --import tsx deployment/sites/local-d1-server.ts",
    "dev:sites:web": "VITE_API_URL=/api/v1 VITE_API_PROXY_ORIGIN=http://127.0.0.1:4000 pnpm --filter @careerground/web dev",
    "build": "pnpm --filter @careerground/ui build && pnpm --filter @careerground/docs build && pnpm sites:build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "workspace:prepare": "pnpm --filter @careerground/contracts build && pnpm --filter @careerground/ui build",
    "typecheck": "pnpm workspace:prepare && pnpm -r --if-present typecheck && pnpm sites:typecheck",
    "test": "pnpm workspace:prepare && pnpm -r --if-present test && vitest run scripts/troubleshooting scripts/slack scripts/learning-catalog scripts/operations scripts/performance scripts/jobs-v5 deployment/sites",
    "test:e2e": "pnpm workspace:prepare && playwright test",
    "test:e2e:visual": "pnpm workspace:prepare && playwright test e2e/visual.spec.ts",
    "db:d1:generate": "drizzle-kit generate",
    "jobs:catalog:refresh": "node scripts/generate-job-refresh-migration.mjs",
    "jobs:catalog:reconcile": "node scripts/generate-job-reconciliation-migration.mjs",
    "jobs:library:insert": "node scripts/generate-library-job-insert-migration.mjs",
    "jobs:validator:sync": "node scripts/generate-validator-job-sync-migration.mjs",
    "jobs:v5:preflight": "node scripts/jobs-v5/cli.mjs preflight",
    "jobs:v5:adapt-v4": "node scripts/jobs-v5/cli.mjs adapt-v4",
    "jobs:v5:handoff": "node scripts/jobs-v5/handoff.mjs",
    "jobs:v5:validate-discovery": "node scripts/jobs-v5/discovery-delta.mjs",
    "jobs:v5:publish-discovery": "node scripts/jobs-v5/publish-discovery.mjs",
    "jobs:v5:collect": "node scripts/jobs-v5/cli.mjs collect",
    "jobs:v5:merge": "node scripts/jobs-v5/cli.mjs merge",
    "jobs:v5:validate": "node scripts/jobs-v5/cli.mjs validate",
    "jobs:v5:publish": "node scripts/jobs-v5/cli.mjs publish",
    "jobs:v5:notify": "node scripts/jobs-v5/cli.mjs notify",
    "jobs:v5:run": "node scripts/jobs-v5/cli.mjs run",
    "jobs:v5:dry-run": "node scripts/jobs-v5/cli.mjs dry-run",
    "learning:catalog:generate": "node scripts/learning-catalog/generate.mjs",
    "learning:catalog:render": "node scripts/learning-catalog/render-visuals.mjs",
    "docs:dev": "pnpm --filter @careerground/docs dev",
    "docs:build": "pnpm --filter @careerground/docs build",
    "sites:build": "pnpm --filter @careerground/contracts build && pnpm --filter @careerground/web build:sites && node --import tsx deployment/sites/build.mjs",
    "sites:stage": "node --import tsx deployment/sites/prepare-package-stage.ts",
    "sites:typecheck": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --lib ES2022,DOM deployment/sites/d1.ts deployment/sites/d1-api.ts deployment/sites/d1-jobs-v5-discovery-contract.ts deployment/sites/d1-jobs-v5.ts deployment/sites/worker.ts deployment/sites/local-d1.ts deployment/sites/local-d1-server.ts deployment/sites/dev.ts deployment/sites/prepare-package-stage.ts deployment/sites/migration-authority.ts",
    "evidence:collect": "node --import tsx scripts/troubleshooting/collect-evidence.ts",
    "troubleshoot:generate": "node --import tsx scripts/troubleshooting/generate.ts",
    "troubleshoot:validate": "node --import tsx scripts/troubleshooting/validate.ts",
    "evidence:optimize-images": "node --import tsx scripts/troubleshooting/optimize-images.ts",
    "learning:optimize-images": "node scripts/optimize-learning-images.mjs",
    "performance:budget": "node scripts/performance/check-budgets.mjs",
    "bundle:budget": "node scripts/performance/check-web-bundle-budgets.mjs",
    "slo:check": "node scripts/operations/check-production-slo.mjs",
    "recovery:drill": "node --import tsx scripts/data-integrity/restore-drill.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
