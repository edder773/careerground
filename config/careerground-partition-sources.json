    "excluded": [
      "MANDATORY_EXPERIENCE_ONE_YEAR_OR_MORE",
      "CAREER_ONLY",
      "NON_IT",
      "SECURITY_ONLY",
      "QA_TEST_ONLY",
      "SALES_MARKETING_HR_ACCOUNTING_LEGAL_ADMIN",
      "HARDWARE_CIRCUIT_PRODUCTION_ONLY",
      "EDUCATION_BOOTCAMP_EXTERNAL_ACTIVITY",
      "TALENT_POOL",
      "OVERSEAS_ONLY",
      "CLOSED_REMOVED_CANCELLED"
    ],
    "evidencePriority": [
      "OFFICIAL_CAREERS",
      "OFFICIAL_ATS",
      "PLATFORM_DETAIL_WITH_ACTIVE_APPLICATION",
      "PLATFORM_LIST",
      "SEARCH_SNIPPET"
    ],
    "accessFailureDecision": "RETAINED_UNCONFIRMED",
    "uncertainPublishAllowed": false,
    "deleteJobsAllowed": false,
    "mutateSavedJobsAllowed": false
  }
}
