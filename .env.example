NODE_ENV=development
APP_NAME=CareerGround
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
API_PORT=4000
DATABASE_URL=postgresql://careerground:careerground@localhost:5432/careerground?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
MAX_ACTIVE_USERS=10
BOOTSTRAP_ADMIN_EMAIL=admin@careerground.local
BOOTSTRAP_ADMIN_PASSWORD=
INTERNAL_SERVICE_SECRET=replace-with-a-long-internal-secret
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
AI_LEARNING_ENABLED=false
OPENAI_API_KEY=
OPENAI_LEARNING_MODEL=
OPENAI_TROUBLESHOOTING_MODEL=
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
