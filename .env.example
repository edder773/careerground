NODE_ENV=development
APP_NAME=CareerGround
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
API_PORT=4000
DATABASE_URL=postgresql://careerground:careerground@localhost:5432/careerground?schema=public
MAX_ACTIVE_USERS=10
BOOTSTRAP_ADMIN_EMAIL=admin@careerground.local
OPENAI_ADMIN_EMAILS=admin@careerground.local
# Same random secret must be set on the Sites Worker and API deployment.
SITES_AUTH_SHARED_SECRET=replace-me
# Deterministic forwarded-header boundary for automated tests only; production always disables it.
OPENAI_AUTH_MOCK=false
INTERNAL_SERVICE_SECRET=replace-me
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
AI_LEARNING_ENABLED=false
OPENAI_API_KEY=
OPENAI_LEARNING_MODEL=
OPENAI_TROUBLESHOOTING_MODEL=
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
